schema = 4

[roles]
{% if 'specs' in capabilities %}
specs = "openspec"
{% endif %}
{% if 'tracker' in capabilities %}
tracker = "{{ tracker }}"
{% endif %}
{% if 'knowledge' in capabilities %}
knowledge = {{ knowledge | tojson }}
{% endif %}
{% if 'scm' in capabilities %}
scm = "github"
{% endif %}
{% if 'deploy' in capabilities %}
deploy = "none"
{% endif %}
{% if 'agent-client' in capabilities %}
agent-client = {{ agent_clients | tojson }}
{% endif %}

{% if 'tracker' in capabilities %}
[providers.{{ tracker }}]
{% for key, value in tracker_settings.items() %}
{{ key }} = {{ value | tojson }}
{% endfor %}
# Select verified project/account settings with ai-dlc provider connect.
# No account identity or credentials are inferred from scaffolding.
{% endif %}

[gates]
finish = ["specification-current", "pr-merged", "ci-green"]

[checks]
required = ["generated", "work-records"{% if initialize and preset != 'generic' %}, "language-check"{% endif %}{% if 'backend' in capabilities %}, "api-contract"{% if preset == 'python' %}, "api-contract-drift"{% endif %}{% endif %}]

[checks.commands]
generated = "ai-dlc agents render --check"
work-records = "ai-dlc work validate --all"
{% if initialize and preset == 'python' %}
language-check = "uv run --locked --no-sync python -m compileall -f -q src"
{% elif initialize and preset == 'node' %}
language-check = "node --check src/index.js"
{% elif initialize and preset == 'rust' %}
language-check = "cargo check --locked"
{% endif %}

{% if 'backend' in capabilities %}
{% if preset == 'node' %}
api-contract = "REDOCLY_TELEMETRY=off npx --offline --no-install @redocly/cli@1.34.16 lint docs/api/openapi.yaml --extends minimal"
{% elif preset == 'python' %}
api-contract = "uv run --locked --no-sync --offline --with openapi-spec-validator==0.7.2 python -m openapi_spec_validator docs/api/openapi.yaml"
api-contract-drift = "uv run --locked --no-sync --offline --with openapi-spec-validator==0.7.2 python scripts/check_api_contract_drift.py"
{% else %}
api-contract = "uvx --offline --from openapi-spec-validator==0.7.2 openapi-spec-validator docs/api/openapi.yaml"
{% endif %}
{% endif %}

[setup]
steps = [
{% if preset == 'python' %}
  {id = "dependencies", command = "{% if initialize %}(test -f uv.lock || uv lock) && {% else %}test -f uv.lock && {% endif %}uv sync --locked", verify = "uv sync --locked --check"},
{% elif preset == 'node' %}
  {id = "dependencies", command = "{% if initialize %}(test -f package-lock.json || npm install --package-lock-only --ignore-scripts) && {% endif %}npm ci", verify = "npm ls --all --parseable"},
{% elif preset == 'rust' %}
  {id = "dependencies", command = "{% if initialize %}(test -f Cargo.lock || cargo generate-lockfile) && {% endif %}cargo fetch --locked", verify = "cargo fetch --locked --offline"},
{% endif %}
{% if 'backend' in capabilities %}
{% if preset == 'node' %}
  {id = "api-contract-tools", command = "REDOCLY_TELEMETRY=off npx --yes @redocly/cli@1.34.16 --version", verify = "REDOCLY_TELEMETRY=off npx --offline --no-install @redocly/cli@1.34.16 --version"},
{% elif preset == 'python' %}
  {id = "api-contract-tools", command = "uv run --locked --no-sync --with openapi-spec-validator==0.7.2 python -m openapi_spec_validator docs/api/openapi.yaml", verify = "uv run --locked --no-sync --offline --with openapi-spec-validator==0.7.2 python -c 'import openapi_spec_validator'"},
{% else %}
  {id = "api-contract-tools", command = "uvx --from openapi-spec-validator==0.7.2 openapi-spec-validator docs/api/openapi.yaml", verify = "uvx --offline --from openapi-spec-validator==0.7.2 openapi-spec-validator --help"},
{% endif %}
{% endif %}
]

# Set scm.repository to your selected owner/repository before SCM operations.
# Extend required checks with application-specific validation before completing real work.
