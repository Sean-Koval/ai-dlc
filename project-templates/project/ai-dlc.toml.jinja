schema = 4

[roles]
{% if 'specs' in capabilities %}
specs = "openspec"
{% endif %}
{% if 'tracker' in capabilities %}
tracker = "{{ tracker }}"
{% endif %}
{% if 'knowledge' in capabilities %}
knowledge = {{ knowledge | tojson }}
{% endif %}
{% if 'scm' in capabilities %}
scm = "github"
{% endif %}
{% if 'deploy' in capabilities %}
deploy = "none"
{% endif %}
{% if 'agent-client' in capabilities %}
agent-client = {{ agent_clients | tojson }}
{% endif %}

{% if 'tracker' in capabilities %}
[providers.{{ tracker }}]
{% for key, value in tracker_settings.items() %}
{{ key }} = {{ value | tojson }}
{% endfor %}
# Select verified project/account settings with ai-dlc provider connect.
# No account identity or credentials are inferred from scaffolding.
{% endif %}

[gates]
finish = ["specification-current", "pr-merged", "ci-green"]

[checks]
required = ["generated", "work-records"{% if 'frontend' in capabilities %}, "frontend-smoke"{% endif %}{% if initialize and preset != 'generic' %}, "language-check"{% endif %}{% if initialize and preset == 'python' %}, "application-tests"{% endif %}{% if 'backend' in capabilities %}, "api-contract"{% if preset == 'python' %}, "api-contract-drift"{% endif %}{% endif %}]

[checks.commands]
generated = {argv = ["ai-dlc", "agents", "render", "--check"]}
work-records = {argv = ["ai-dlc", "work", "validate", "--all"]}
{% if 'frontend' in capabilities %}
frontend-smoke = "if [ -z \"${BASE_URL:-}\" ]; then echo 'Frontend smoke requires BASE_URL for a running app; start the app and set BASE_URL.' >&2; exit 2; fi; PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npx --offline --no-install playwright test --reporter=line"
{% endif %}
{% if initialize and preset == 'python' %}
language-check = {argv = ["python", "scripts/setup_python.py", "--run", "-m", "compileall", "-f", "-q", "src"]}
application-tests = {argv = ["python", "scripts/setup_python.py", "--run", "scripts/check_tests.py"]}
{% elif initialize and preset == 'node' %}
language-check = "node --check src/index.js"
{% elif initialize and preset == 'rust' %}
language-check = "cargo check --locked"
{% endif %}

{% if 'backend' in capabilities %}
{% if preset == 'node' %}
api-contract = "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true npx --offline --no-install @redocly/cli@1.34.16 lint docs/api/openapi.yaml --extends minimal"
{% elif preset == 'python' %}
api-contract = {argv = ["uv", "run", "--locked", "--no-sync", "--offline", "--with", "openapi-spec-validator==0.7.2", "python", "-m", "openapi_spec_validator", "docs/api/openapi.yaml"]}
api-contract-drift = {argv = ["uv", "run", "--locked", "--no-sync", "--offline", "--with", "openapi-spec-validator==0.7.2", "python", "scripts/check_api_contract_drift.py"]}
{% else %}
api-contract = {argv = ["uvx", "--offline", "--from", "openapi-spec-validator==0.7.2", "openapi-spec-validator", "docs/api/openapi.yaml"]}
{% endif %}
{% endif %}

[setup]
steps = [
{% if preset == 'python' %}
  {id = "dependencies", command = {argv = ["python", "scripts/setup_python.py"{% if initialize %}, "--initialize"{% endif %}]}, verify = {argv = ["python", "scripts/setup_python.py", "--verify"]}, inputs = ["scripts/setup_python.py"]},
{% elif preset == 'node' %}
  {id = "dependencies", command = "{% if initialize %}(test -f package-lock.json || npm install --package-lock-only --ignore-scripts) && {% endif %}{% if 'frontend' in capabilities %}PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 {% endif %}npm ci", verify = "npm ls --all --parseable"},
{% elif preset == 'rust' %}
  {id = "dependencies", command = "{% if initialize %}(test -f Cargo.lock || cargo generate-lockfile) && {% endif %}cargo fetch --locked", verify = "cargo fetch --locked --offline"},
{% endif %}
{% if 'backend' in capabilities %}
{% if preset == 'node' %}
  {id = "api-contract-tools", command = "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true npx --yes @redocly/cli@1.34.16 --version", verify = "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true npx --offline --no-install @redocly/cli@1.34.16 --version"},
{% elif preset == 'python' %}
  {id = "api-contract-tools", command = {argv = ["uv", "run", "--locked", "--no-sync", "--with", "openapi-spec-validator==0.7.2", "python", "-m", "openapi_spec_validator", "docs/api/openapi.yaml"]}, verify = {argv = ["uv", "run", "--locked", "--no-sync", "--offline", "--with", "openapi-spec-validator==0.7.2", "python", "-c", "import openapi_spec_validator"]}},
{% else %}
  {id = "api-contract-tools", command = {argv = ["uvx", "--from", "openapi-spec-validator==0.7.2", "openapi-spec-validator", "docs/api/openapi.yaml"]}, verify = {argv = ["uvx", "--offline", "--from", "openapi-spec-validator==0.7.2", "openapi-spec-validator", "--help"]}},
{% endif %}
{% endif %}
]

# Set scm.repository to your selected owner/repository before SCM operations.
# Extend required checks with application-specific validation before completing real work.
