{
  "$defs": {
    "CaptureSource": {
      "additionalProperties": false,
      "description": "Where a captured note came from: one exported ``file`` or a chat ``room``.\n\n``sha256`` is the digest of the captured text; a capture refuses a digest it has\nalready seen. The raw transcript itself is never stored in the note.",
      "oneOf": [
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "room"
          ]
        }
      ],
      "properties": {
        "file": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "room": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256"
      ],
      "title": "CaptureSource",
      "type": "object"
    },
    "Check": {
      "additionalProperties": true,
      "description": "One ADR check: a ``flightdeck.spec/v1`` spec without its header.\n\nOnly the shape is checked. Unknown keys are kept because the grammar is additive.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "assert": {
          "additionalProperties": true,
          "maxProperties": 1,
          "minProperties": 1,
          "title": "Assert",
          "type": "object"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "turn",
                "job",
                "session"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "harness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness"
        },
        "applies_when": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies When"
        },
        "severity": {
          "anyOf": [
            {
              "enum": [
                "warn",
                "fail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        }
      },
      "required": [
        "id",
        "assert"
      ],
      "title": "Check",
      "type": "object"
    },
    "Publish": {
      "additionalProperties": false,
      "dependentRequired": {
        "page_id": [
          "version"
        ],
        "version": [
          "page_id"
        ]
      },
      "description": "The Confluence page a note is published to; ``page_id`` and ``version`` once done.",
      "properties": {
        "site": {
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
          "title": "Site",
          "type": "string"
        },
        "space": {
          "minLength": 1,
          "title": "Space",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "site",
        "space"
      ],
      "title": "Publish",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "hash": {
          "pattern": "^[a-z0-9-]+:\\S+$",
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "hash"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "learning"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          }
        },
        "required": [
          "sources"
        ]
      }
    },
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "status"
              ]
            },
            {
              "required": [
                "checks"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "daily",
              "meeting",
              "thread"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "origin"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "meeting",
              "thread"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "source"
        ]
      }
    },
    {
      "if": {
        "required": [
          "publish"
        ]
      },
      "then": {
        "required": [
          "origin"
        ]
      }
    }
  ],
  "description": "Frontmatter of a learning, decision, runbook, note or capture.\n\n``work`` and ``repository`` are kept for learnings written before this schema.\nExtra keys are allowed and preserved so neighbouring tools can extend notes additively.",
  "properties": {
    "id": {
      "pattern": "^(learning|decision|runbook|note|daily|meeting|thread)/[a-z0-9][a-z0-9._-]*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "learning",
        "decision",
        "runbook",
        "note",
        "daily",
        "meeting",
        "thread"
      ],
      "title": "Kind",
      "type": "string"
    },
    "scope": {
      "enum": [
        "personal",
        "project",
        "team"
      ],
      "title": "Scope",
      "type": "string"
    },
    "label": {
      "description": "internal | confidential; free text is recorded",
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "author": {
      "pattern": "^(human|agent):\\S+$",
      "title": "Author",
      "type": "string"
    },
    "confidence": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "valid_from": {
      "format": "date",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "review_by": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review By"
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "proposed",
            "accepted",
            "superseded",
            "rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "checks": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checks"
    },
    "work": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work"
    },
    "repository": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
    },
    "origin": {
      "anyOf": [
        {
          "enum": [
            "work",
            "home"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The vault a note was captured in; required on captures",
      "title": "Origin"
    },
    "lane": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Epic key",
      "title": "Lane"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "publish": {
      "anyOf": [
        {
          "$ref": "#/$defs/Publish"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "kind",
    "scope",
    "label",
    "author",
    "valid_from"
  ],
  "title": "Knowledge note frontmatter",
  "type": "object"
}
