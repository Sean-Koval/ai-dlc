{
  "additionalProperties": false,
  "description": "One reviewed note to one page (ADR 0003): create without ``page_id``, else update.\n\n``expected_version`` is the version the note recorded; a provider refuses when the\npage's current version differs instead of overwriting a teammate's edit.",
  "properties": {
    "body": {
      "minLength": 1,
      "title": "Body",
      "type": "string"
    },
    "expected_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Version"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "page_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Id"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent"
    },
    "site": {
      "minLength": 1,
      "title": "Site",
      "type": "string"
    },
    "space": {
      "minLength": 1,
      "title": "Space",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "site",
    "space",
    "title",
    "body",
    "operation_id"
  ],
  "title": "Publish",
  "type": "object"
}
