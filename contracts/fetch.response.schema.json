{
  "$defs": {
    "Utterance": {
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "minLength": 1,
          "title": "Speaker",
          "type": "string"
        },
        "at": {
          "description": "HH:MM:SS offset",
          "pattern": "^[0-9]{1,3}:[0-5][0-9]:[0-5][0-9]$",
          "title": "At",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "speaker",
        "at",
        "text"
      ],
      "title": "Utterance",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "id": {
      "description": "stable per provider; capture is idempotent by it",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "participants": {
      "description": "display names",
      "items": {
        "type": "string"
      },
      "title": "Participants",
      "type": "array"
    },
    "emails": {
      "description": "routing only; never stored",
      "items": {
        "type": "string"
      },
      "title": "Emails",
      "type": "array"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Utterance"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "start",
    "segments"
  ],
  "title": "Transcript",
  "type": "object"
}
